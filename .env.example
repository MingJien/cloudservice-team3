# Docker Compose local demo values. Replace every value before a shared or production deployment.
MSSQL_SA_PASSWORD=CloudService-Local-Sa-Password-2026!
JWT_SECRET=CloudService-Local-Jwt-Secret-Replace-Before-Production-2026!
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true
SEED_DEMO_USERS_ENABLED=true
SEED_DEMO_CONTENT_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_FULLNAME=CloudService Administrator
SEED_ADMIN_EMAIL=admin@cloudservice.local
SEED_ADMIN_PASSWORD=ad123
SEED_EDITOR_USERNAME=editor
SEED_EDITOR_FULLNAME=CloudService Editor
SEED_EDITOR_EMAIL=editor@cloudservice.local
SEED_EDITOR_PASSWORD=ed123
SESSION_COOKIE_SECURE=false
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_BASE_URL=http://localhost:3000
TELEGRAM_MASK_CUSTOMER_CONTACT=true
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mekongnode.local
SMTP_FROM_NAME=MekongNode Partner Network
SMTP_PORTAL_URL=http://localhost:3000/affiliate/login

# Docker Compose puts frontend and API behind one Nginx origin. A relative
# base also survives a new Cloudflare Quick-Tunnel hostname. For a separately
# deployed Vercel frontend, override this with https://your-api.example/api.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_DEMO_MODE=true

# ASP.NET local-run equivalents when the API is started without Docker.
ConnectionStrings__DefaultConnection=Server=MSI\MCHIENCS;Database=CloudServiceDb;Integrated Security=True;TrustServerCertificate=True;App=EntityFramework
Jwt__Secret=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
Database__ApplyMigrationsOnStartup=false
Seed__DemoUsers__Enabled=false
Seed__DemoContent__Enabled=false
Seed__DemoUsers__Admin__UserName=admin
Seed__DemoUsers__Admin__FullName=Quản trị viên Demo
Seed__DemoUsers__Admin__Email=admin@example.local
Seed__DemoUsers__Admin__Password=CHANGE_ME_LOCAL_ADMIN_PASSWORD
Seed__DemoUsers__Editor__UserName=editor
Seed__DemoUsers__Editor__FullName=Biên tập viên Demo
Seed__DemoUsers__Editor__Email=editor@example.local
Seed__DemoUsers__Editor__Password=CHANGE_ME_LOCAL_EDITOR_PASSWORD
Smtp__Enabled=false
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__UserName=
Smtp__Password=
Smtp__FromEmail=no-reply@mekongnode.local
Smtp__FromName=MekongNode Partner Network
Smtp__PortalUrl=http://localhost:3000/affiliate/login
