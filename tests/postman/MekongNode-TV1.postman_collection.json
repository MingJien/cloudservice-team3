{
  "info": {
    "name": "MekongNode - TV1",
    "description": "Smoke tests for Tech Lead APIs. Password variables stay local and are never committed with values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Health is OK', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userNameOrEmail\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{apiUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login succeeds', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.environment.set('accessToken', body.accessToken);", "pm.environment.set('refreshToken', body.refreshToken);"] } }]
        },
        {
          "name": "Rotate Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{apiUrl}}/auth/refresh"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Refresh rotates successfully', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.environment.set('accessToken', body.accessToken);", "pm.environment.set('refreshToken', body.refreshToken);"] } }]
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{adminPassword}}\",\n  \"newPassword\": \"{{adminNewPassword}}\"\n}" },
            "url": "{{apiUrl}}/auth/change-password"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Password change returns 204', () => pm.response.to.have.status(204));"] } }]
        }
      ]
    },
    {
      "name": "Audit Logs - Admin",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
        "url": "{{apiUrl}}/audit-logs?pageNumber=1&pageSize=20"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Admin can read audit logs', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "Pricing Quote",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"servicePlanId\": {{planId}},\n  \"billingCycle\": \"Monthly\",\n  \"promotionCode\": null\n}" },
        "url": "{{apiUrl}}/pricing/quotes"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Quote succeeds', () => pm.response.to.have.status(200));", "pm.test('Total is server-calculated', () => pm.expect(pm.response.json().totalPrice).to.be.a('number'));"] } }]
    },
    {
      "name": "Compare Plans",
      "request": { "method": "GET", "url": "{{apiUrl}}/service-plans/compare?ids={{compareIds}}" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Compare succeeds', () => pm.response.to.have.status(200));", "pm.test('At most three plans', () => pm.expect(pm.response.json().plans.length).to.be.at.most(3));"] } }]
    },
    {
      "name": "Compare Rejects More Than Three",
      "request": { "method": "GET", "url": "{{apiUrl}}/service-plans/compare?ids=1,2,3,4" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('More than three is rejected', () => pm.response.to.have.status(400));"] } }]
    },
    {
      "name": "Rule-based Advisor",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"budget\": 600000,\n  \"billingCycle\": \"Monthly\",\n  \"purpose\": \"Website\",\n  \"traffic\": \"Medium\",\n  \"minimumCpuCores\": 0,\n  \"minimumRamGb\": 0,\n  \"minimumStorageGb\": 20,\n  \"maxResults\": 3\n}" },
        "url": "{{apiUrl}}/service-plan-recommendations"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Advisor succeeds', () => pm.response.to.have.status(200));", "const items = pm.response.json().items;", "pm.test('Returns one to three explainable recommendations', () => { pm.expect(items.length).to.be.within(1, 3); pm.expect(items[0].reasons.length).to.be.above(0); });"] } }]
    }
  ]
}
